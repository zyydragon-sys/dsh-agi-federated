{
  "name": "dsh-agi-federated",
  "version": "1.6.6",
  "private": true,
  "author": "txcdragon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyydragon-sys/dsh-agi-federated.git"
  },
  "homepage": "https://github.com/zyydragon-sys/dsh-agi-federated#readme",
  "type": "module",
  "description": "Federated AGI layer for DeepSeek Harness: bounded hot memory, clue/BM25 recall, deterministic surface compaction, staged skills, evidence gate, usage/balance monitor, zero-trust audit, and JEPA/CUV/mp-rcp seams.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "bm25",
    "compaction",
    "evidence",
    "usage"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./schemas/config.js": "./schemas/config.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "schemas/config.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "MAINTENANCE.md",
    "EVOLUTION.md",
    "plugins/**",
    "scripts/**"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20.11.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
