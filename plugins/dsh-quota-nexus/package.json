{
  "name": "dsh-quota-nexus",
  "version": "1.22.3",
  "private": true,
  "type": "module",
  "description": "Multi-provider model quota nexus for DeepSeek Harness: provider registry, O(1) lease scheduler, write-behind ledger, breaker, SSE quota telemetry, capability-aware model rotation and real token/cost analytics.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.0 <1.0.0",
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "rate-limit",
    "multi-provider"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./schemas/config.js": "./schemas/config.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "schemas/config.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/selftest.mjs"
  }
}
